@using CityLink_SCP.DbModels
@model List<EventRegistration>
@{
    string sortBy    = ViewData["SortBy"]    as string ?? "EventId";
    string sortOrder = ViewData["SortOrder"] as string ?? "desc";
    string SortClass(string field) => sortBy == field ? "th-sort-" + sortOrder : "";
}

@if (Model != null && Model.Any())
{
    <div class="table-wrap">
        <table class="admin-table" id="regsTable">
            <thead>
                <tr>
                    <th data-sort="EventName"         class="@SortClass("EventName")">Event</th>
                    <th data-sort="UserName"          class="@SortClass("UserName")">User</th>
                    <th data-hide-priority="2"
                        data-sort="NumberOfAttendees" class="@SortClass("NumberOfAttendees")">Attendees</th>
                    <th data-hide-priority="1"
                        data-sort="TotalCost"         class="@SortClass("TotalCost")">Total Cost</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr data-reg-userid="@r.UserId" data-reg-eventid="@r.EventId">
                        <td>@r.Event?.Title</td>
                        <td class="col-muted">@r.User?.FirstName @r.User?.LastName</td>
                        <td class="col-muted">@r.NumberOfAttendees</td>
                        <td>$@r.TotalCost.ToString("0.00")</td>
                        <td class="col-actions">
                            <button class="btn--admin btn--danger btn--sm delete-reg-btn"
                                    data-userid="@r.UserId"
                                    data-eventid="@r.EventId"
                                    data-label="@r.User?.FirstName @r.User?.LastName — @r.Event?.Title">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" />
}
else
{
    <div class="empty-state">No event registrations found.</div>
}
