@using CityLink_SCP.DbModels
@model List<Event>
@{
    string sortBy    = ViewData["SortBy"]    as string ?? "Id";
    string sortOrder = ViewData["SortOrder"] as string ?? "desc";

    string SortClass(string field) =>
        sortBy == field ? "th-sort-" + sortOrder : "";
}

@if (Model != null && Model.Any())
{
    <div class="table-wrap">
        <table class="admin-table" id="eventsTable">
            <thead>
                <tr>
                    <th data-hide-priority="3"
                        data-sort="Id"              class="@SortClass("Id")">ID</th>
                    <th data-sort="Title"           class="@SortClass("Title")">Title</th>
                    <th data-hide-priority="5"
                        data-sort="Location"        class="@SortClass("Location")">Location</th>
                    <th data-sort="Start_Date_Time" class="@SortClass("Start_Date_Time")">Start</th>
                    <th data-hide-priority="1"
                        data-sort="Cost"            class="@SortClass("Cost")">Cost</th>
                    <th data-hide-priority="2"
                        data-sort="Max_Capcity"     class="@SortClass("Max_Capcity")">Capacity</th>
                    <th data-hide-priority="2"
                        data-sort="TotalAttendees"  class="@SortClass("TotalAttendees")">Attendees</th>
                    <th data-hide-priority="4"
                        data-sort="StaffName"       class="@SortClass("StaffName")">Staff</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model)
                {
                    <tr data-event-id="@ev.Id">
                        <td class="col-muted">#@ev.Id</td>
                        <td>@ev.Title</td>
                        <td class="col-muted">@ev.Location</td>
                        <td class="col-muted">@ev.Start_Date_Time.ToString("dd MMM yyyy, HH:mm")</td>
                        <td>$@ev.Cost.ToString("0.00")</td>
                        <td class="col-muted">@ev.Max_Capcity</td>
                        <td class="col-muted">@ev.TotalAttendees</td>
                        <td class="col-muted">@ev.Staff?.FirstName @ev.Staff?.LastName</td>
                        <td class="col-actions">
                            <button class="btn--admin btn--ghost btn--sm view-event-btn" data-id="@ev.Id">View</button>
                            <button class="btn--admin btn--ghost btn--sm edit-event-btn" data-id="@ev.Id">Edit</button>
                            <button class="btn--admin btn--danger btn--sm delete-event-btn" data-id="@ev.Id" data-title="@ev.Title">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" />
}
else
{
    <div class="empty-state">No events match your search.</div>
}
