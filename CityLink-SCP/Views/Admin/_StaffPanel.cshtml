@using CityLink_SCP.DbModels
@model ApplicationStaff?
@{
    var isNew  = string.IsNullOrEmpty(Model?.Id);
    var action = isNew ? "/Admin/CreateStaff" : "/Admin/UpdateStaff";
}

<div class="xml-panel">
    <div class="xml-panel__header">
        <div>
            <p class="xml-panel__eyebrow">Staff Members</p>
            <h2 class="xml-panel__title" id="staff-panel-title">@(isNew ? "New Staff Member" : Model!.FirstName + " " + Model!.LastName)</h2>
        </div>
        <button type="button" class="xml-panel__close" id="closeStaffPanel" aria-label="Close">&#x2715;</button>
    </div>

    <form id="staff-form" method="post" action="@action">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model?.Id" />

        <div id="staff-form-pane" class="xml-panel__body panel-scroll">
            <div class="crud-form-grid">
                <div class="crud-field">
                    <label class="crud-field__label" for="staffFirstName">First Name *</label>
                    <input type="text" id="staffFirstName" name="First_Name" class="crud-input" placeholder="John" value="@Model?.FirstName" />
                </div>
                <div class="crud-field">
                    <label class="crud-field__label" for="staffLastName">Last Name</label>
                    <input type="text" id="staffLastName" name="Last_Name" class="crud-input" placeholder="Doe" value="@Model?.LastName" />
                </div>
                <div class="crud-field">
                    <label class="crud-field__label" for="staffEmail">Email *</label>
                    <input type="email" id="staffEmail" name="Email" class="crud-input" placeholder="john@citylink.wa.gov.au" value="@Model?.Email" />
                </div>
                <div class="crud-field">
                    <label class="crud-field__label" for="staffPhone">Phone</label>
                    <input type="text" id="staffPhone" name="Phone_Number" class="crud-input" placeholder="08 XXXX XXXX" value="@Model?.PhoneNumber" />
                </div>
                <div class="crud-field">
                    <label class="crud-field__label" for="staffRole">Role *</label>
                    <input type="text" id="staffRole" name="JobTitle" class="crud-input" placeholder="e.g. Administrator" value="@Model?.JobTitle" />
                </div>
                <div class="crud-field">
                    <label class="crud-field__label" for="staffAddress">Address</label>
                    <input type="text" id="staffAddress" name="Address" class="crud-input" placeholder="123 Example St" value="@Model?.Address" />
                </div>
                <div class="crud-field crud-field--full">
                    <label class="crud-field__label" for="staffPassword">
                        Password <span class="crud-field__hint">(leave blank to keep unchanged)</span>
                    </label>
                    <input type="password" id="staffPassword" name="Password" class="crud-input" placeholder="••••••••" autocomplete="new-password" />
                </div>
            </div>
            <div id="staff-status" class="xml-status" style="margin:0.75rem 0 0;"></div>
        </div>

        <div id="staff-panel-actions" class="xml-panel__actions panel-footer">
            <button type="button" class="btn--admin btn--ghost btn--sm" id="cancelStaffBtn">Cancel</button>
            <button type="button" class="btn--admin btn--ghost btn--sm panel-edit-btn" data-prefix="staff" style="display:none;">Edit</button>
            <button type="submit" class="btn--admin btn--primary btn--sm panel-save-btn">&#10003; Save Staff</button>
        </div>
    </form>
</div>
