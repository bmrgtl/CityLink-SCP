@using CityLink_SCP.DbModels
@model Feedback?
@{
    var from   = Model?.User != null ? Model.User.FirstName + " " + Model.User.LastName : "(Guest)";
    var date   = Model != null ? Model.CreatedAt.ToString("dd MMM yyyy") : "";
    var status = (int)(Model?.Status ?? 0);
    var staff  = ViewData["Staff"] as List<ApplicationStaff> ?? new List<ApplicationStaff>();
}

<div class="xml-panel">
    <div class="xml-panel__header">
        <div>
            <p class="xml-panel__eyebrow">Feedback &amp; Enquiries</p>
            <h2 class="xml-panel__title" id="feedback-panel-title">@(Model != null ? "Feedback #" + Model.Id : "Feedback")</h2>
        </div>
        <button type="button" class="xml-panel__close" id="closeFeedbackPanel" aria-label="Close">&#x2715;</button>
    </div>

    <div id="feedback-form-pane" class="xml-panel__body panel-scroll">
        <div class="crud-detail-grid" style="grid-template-columns:1fr;margin-bottom:1.25rem;">
            <div class="crud-field">
                <p class="crud-field__label">From</p>
                <p class="crud-detail-value">@from</p>
            </div>
            <div class="crud-field">
                <p class="crud-field__label">Received</p>
                <p class="crud-detail-value col-muted">@date</p>
            </div>
            <div class="crud-field">
                <p class="crud-field__label">Message</p>
                <p class="crud-detail-value" style="white-space:pre-wrap;line-height:1.7;">@Model?.Message</p>
            </div>
        </div>

        <form id="feedback-form" method="post" action="/Admin/UpdateFeedback">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model?.Id" />

            <div class="crud-form-grid">
                <div class="crud-field">
                    <label class="crud-field__label" for="feedbackStatus">Status *</label>
                    <select id="feedbackStatus" name="Status" class="crud-input">
                        <option value="0" selected="@(status == 0)">Pending</option>
                        <option value="1" selected="@(status == 1)">In Progress</option>
                        <option value="2" selected="@(status == 2)">Resolved</option>
                        <option value="3" selected="@(status == 3)">Closed</option>
                    </select>
                </div>
                <div class="crud-field">
                    <label class="crud-field__label" for="feedbackStaffId">Assigned Staff *</label>
                    <select id="feedbackStaffId" name="StaffId" class="crud-input">
                        <option value="">— select staff —</option>
                        @foreach (var s in staff)
                        {
                            <option value="@s.Id" selected="@(Model?.StaffId == s.Id)">@s.FirstName @s.LastName</option>
                        }
                    </select>
                </div>
                <div class="crud-field crud-field--full">
                    <label class="crud-field__label" for="feedbackResolution">Resolution Message</label>
                    <textarea id="feedbackResolution" name="Resolution_Message" class="crud-input crud-textarea" rows="4"
                              placeholder="Explain how this was resolved…">@Model?.Resolution_Message</textarea>
                </div>
            </div>
            <div id="feedback-status" class="xml-status" style="margin:0.75rem 0 0;"></div>
        </form>
    </div>

    <div id="feedback-panel-actions" class="xml-panel__actions panel-footer">
        <button type="button" class="btn--admin btn--ghost btn--sm" id="cancelFeedbackBtn">Cancel</button>
        <button type="button" class="btn--admin btn--ghost btn--sm panel-edit-btn" data-prefix="feedback" style="display:none;">Resolve</button>
        <button type="submit" form="feedback-form" class="btn--admin btn--primary btn--sm panel-save-btn">&#10003; Save</button>
    </div>
</div>
