<div id="event-overlay" class="xml-overlay" aria-hidden="true">
    <div class="xml-panel">
        <div class="xml-panel__header">
            <div>
                <p class="xml-panel__eyebrow">Events</p>
                <h2 class="xml-panel__title" id="event-panel-title">New Event</h2>
            </div>
            <button class="xml-panel__close" id="closeEventPanel" aria-label="Close">&#x2715;</button>
        </div>

        <div id="event-form-pane" class="xml-panel__body panel-scroll">
            <input type="hidden" id="eventId" value="" />
            <div class="crud-form-grid">
                <div class="crud-field">
                    <label class="crud-field__label" for="eventTitle">Title *</label>
                    <input type="text" id="eventTitle" class="crud-input" placeholder="e.g. Farmers Market" />
                </div>
                <div class="crud-field">
                    <label class="crud-field__label" for="eventLocation">Location *</label>
                    <input type="text" id="eventLocation" class="crud-input" placeholder="e.g. City Square" />
                </div>
                <div class="crud-field">
                    <label class="crud-field__label" for="eventStart">Start *</label>
                    <input type="datetime-local" id="eventStart" class="crud-input" />
                </div>
                <div class="crud-field">
                    <label class="crud-field__label" for="eventEnd">End *</label>
                    <input type="datetime-local" id="eventEnd" class="crud-input" />
                </div>
                <div class="crud-field">
                    <label class="crud-field__label" for="eventCost">Cost ($)</label>
                    <input type="number" id="eventCost" class="crud-input" min="0" step="0.01" placeholder="0.00" />
                </div>
                <div class="crud-field">
                    <label class="crud-field__label" for="eventCapacity">Max Capacity</label>
                    <input type="number" id="eventCapacity" class="crud-input" min="1" placeholder="e.g. 100" />
                </div>
                <div class="crud-field">
                    <label class="crud-field__label" for="eventStaffId">Assigned Staff *</label>
                    <select id="eventStaffId" class="crud-input">
                        <option value="">— select staff —</option>
                    </select>
                </div>
                <div class="crud-field crud-field--full">
                    <label class="crud-field__label" for="eventDesc">Description</label>
                    <textarea id="eventDesc" class="crud-input crud-textarea" rows="4" placeholder="Brief description…"></textarea>
                </div>
            </div>
            <div id="event-status" class="xml-status" style="margin:0.75rem 0 0;"></div>
        </div>

        <div id="event-panel-actions" class="xml-panel__actions panel-footer">
            <button class="btn--admin btn--ghost btn--sm" id="cancelEventBtn">Cancel</button>
            <button class="btn--admin btn--ghost btn--sm panel-edit-btn" data-prefix="event" style="display:none;">Edit</button>
            <button class="btn--admin btn--primary btn--sm panel-save-btn" id="saveEventBtn">&#10003; Save Event</button>
        </div>
    </div>
</div>
