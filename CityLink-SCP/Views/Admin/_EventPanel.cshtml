@using CityLink_SCP.DbModels
@model Event?
@{
    var isNew = Model == null || Model.Id == 0;
    var action = isNew ? "/Admin/CreateEvent" : "/Admin/UpdateEvent";
    var startVal = Model != null ? Model.Start_Date_Time.ToString("yyyy-MM-ddTHH:mm") : "";
    var endVal   = Model != null ? Model.End_Date_Time.ToString("yyyy-MM-ddTHH:mm") : "";
    var staff    = ViewData["Staff"] as List<ApplicationStaff> ?? new List<ApplicationStaff>();
}

<div class="xml-panel">
    <div class="xml-panel__header">
        <div>
            <p class="xml-panel__eyebrow">Events</p>
            <h2 class="xml-panel__title" id="event-panel-title">@(isNew ? "New Event" : Model!.Title)</h2>
        </div>
        <button type="button" class="xml-panel__close" id="closeEventPanel" aria-label="Close">&#x2715;</button>
    </div>

    <form id="event-form" method="post" action="@action">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@(Model?.Id ?? 0)" />

        <div id="event-form-pane" class="xml-panel__body panel-scroll">
            <div class="crud-form-grid">
                <div class="crud-field">
                    <label class="crud-field__label" for="eventTitle">Title *</label>
                    <input type="text" id="eventTitle" name="Title" class="crud-input" placeholder="e.g. Farmers Market" value="@Model?.Title" />
                </div>
                <div class="crud-field">
                    <label class="crud-field__label" for="eventLocation">Location *</label>
                    <input type="text" id="eventLocation" name="Location" class="crud-input" placeholder="e.g. City Square" value="@Model?.Location" />
                </div>
                <div class="crud-field">
                    <label class="crud-field__label" for="eventStart">Start *</label>
                    <input type="datetime-local" id="eventStart" name="Start_Date_Time" class="crud-input" value="@startVal" />
                </div>
                <div class="crud-field">
                    <label class="crud-field__label" for="eventEnd">End *</label>
                    <input type="datetime-local" id="eventEnd" name="End_Date_Time" class="crud-input" value="@endVal" />
                </div>
                <div class="crud-field">
                    <label class="crud-field__label" for="eventCost">Cost ($)</label>
                    <input type="number" id="eventCost" name="Cost" class="crud-input" min="0" step="0.01" placeholder="0.00" value="@Model?.Cost" />
                </div>
                <div class="crud-field">
                    <label class="crud-field__label" for="eventCapacity">Max Capacity</label>
                    <input type="number" id="eventCapacity" name="Max_Capcity" class="crud-input" min="1" placeholder="e.g. 100" value="@Model?.Max_Capcity" />
                </div>
                <div class="crud-field">
                    <label class="crud-field__label" for="eventStaffId">Assigned Staff *</label>
                    <select id="eventStaffId" name="StaffId" class="crud-input">
                        <option value="">— select staff —</option>
                        @foreach (var s in staff)
                        {
                            <option value="@s.Id" selected="@(Model?.StaffId == s.Id)">@s.FirstName @s.LastName</option>
                        }
                    </select>
                </div>
                <div class="crud-field crud-field--full">
                    <label class="crud-field__label" for="eventDesc">Description</label>
                    <textarea id="eventDesc" name="Description" class="crud-input crud-textarea" rows="4" placeholder="Brief description…">@Model?.Description</textarea>
                </div>
            </div>
            <div id="event-status" class="xml-status" style="margin:0.75rem 0 0;"></div>
        </div>

        <div id="event-panel-actions" class="xml-panel__actions panel-footer">
            <button type="button" class="btn--admin btn--ghost btn--sm" id="cancelEventBtn">Cancel</button>
            <button type="button" class="btn--admin btn--ghost btn--sm panel-edit-btn" data-prefix="event" style="display:none;">Edit</button>
            <button type="submit" class="btn--admin btn--primary btn--sm panel-save-btn">&#10003; Save Event</button>
        </div>
    </form>
</div>
