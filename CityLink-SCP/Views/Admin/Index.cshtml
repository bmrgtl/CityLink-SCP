@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
    <link rel="stylesheet" href="~/css/index.css" />
}

@section Scripts {
    <script src="~/js/admin.js"></script>
}

@Html.AntiForgeryToken()

<div id="xml-editor-overlay" class="xml-overlay" aria-hidden="true"></div>
<div id="xml-preview-overlay" class="xml-overlay" aria-hidden="true">
    <div class="xml-preview-panel">
        <div class="xml-panel__header">
            <div>
                <p class="xml-panel__eyebrow">Live Preview</p>
                <h2 class="xml-panel__title">Rendered Output</h2>
            </div>
            <button type="button" class="xml-panel__close" id="closePreviewPanel" aria-label="Close preview">&#x2715;</button>
        </div>
        <div id="xml-preview-content" class="xml-preview-content">
            <p style="color:var(--text-muted);font-size:.875rem;">Click "Preview" in the editor to render the current XML.</p>
        </div>
    </div>
</div>
<div id="event-overlay"    class="xml-overlay" aria-hidden="true"></div>
<div id="service-overlay"  class="xml-overlay" aria-hidden="true"></div>
<div id="user-overlay"     class="xml-overlay" aria-hidden="true"></div>
<div id="staff-overlay"    class="xml-overlay" aria-hidden="true"></div>
<div id="feedback-overlay" class="xml-overlay" aria-hidden="true"></div>

<div class="admin-wrap">

    <header class="admin-header">
        <div>
            <h1 class="admin-header__title">Staff Portal</h1>
            <p class="admin-header__sub">CityLink Administration</p>
        </div>
    </header>

    <nav class="admin-tab-nav" role="tablist">
        <button class="admin-tab-btn active"  data-tab="xml"                role="tab">XML Configurations</button>
        <button class="admin-tab-btn"         data-tab="users-staff"        role="tab">Users &amp; Staff</button>
        <button class="admin-tab-btn"         data-tab="feedback"           role="tab">Feedback &amp; Enquiries</button>
        <button class="admin-tab-btn"         data-tab="services-events"    role="tab">Services &amp; Events</button>
        <button class="admin-tab-btn"         data-tab="bookings-regs"      role="tab">Bookings &amp; Registrations</button>
    </nav>

    <div id="tab-xml" class="admin-tab-panel">
        <div id="xml-section-container"></div>
    </div>

    <div id="tab-users-staff" class="admin-tab-panel" style="display:none">
        <div class="tab-columns">
            <div id="users-section-container"></div>
            <div id="staff-section-container"></div>
        </div>
    </div>

    <div id="tab-feedback" class="admin-tab-panel" style="display:none">
        <div id="feedback-section-container"></div>
    </div>

    <div id="tab-services-events" class="admin-tab-panel" style="display:none">
        <div class="tab-columns">
            <div id="services-section-container"></div>
            <div id="events-section-container"></div>
        </div>
    </div>

    <div id="tab-bookings-regs" class="admin-tab-panel" style="display:none">
        <div class="tab-columns">
            <div id="bookings-section-container"></div>
            <div id="registrations-section-container"></div>
        </div>
    </div>

</div>
