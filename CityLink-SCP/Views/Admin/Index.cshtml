@using CityLink_SCP.PageModels
@model AdminIndexViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
    <link rel="stylesheet" href="~/css/index.css" />
}

@section Scripts {
    <script src="~/js/admin.js"></script>
}

@await Html.PartialAsync("_XmlEditorPanel", Model)
@await Html.PartialAsync("_PreviewPanel")
@await Html.PartialAsync("_EventPanel")
@await Html.PartialAsync("_ServicePanel")
@await Html.PartialAsync("_FeedbackPanel")
@await Html.PartialAsync("_UserPanel")
@await Html.PartialAsync("_StaffPanel")


@*  Main Dashboard  *@
<div class="admin-wrap">

    <header class="admin-header">
        <div>
            <h1 class="admin-header__title">Staff Portal</h1>
            <p class="admin-header__sub">CityLink Administration</p>
        </div>
    </header>

    @await Html.PartialAsync("_XmlConfigsSection", Model)
    @await Html.PartialAsync("_EventsSection", Model.Events)
    @await Html.PartialAsync("_ServicesSection", Model.Services)
    @await Html.PartialAsync("_FeedbackSection", Model.Feedbacks)
    @await Html.PartialAsync("_EventRegistrationsSection", Model.EventRegistrations)
    @await Html.PartialAsync("_ServiceBookingsSection", Model.ServiceBookings)
    @await Html.PartialAsync("_UsersSection", Model.Users)
    @await Html.PartialAsync("_StaffSection", Model.StaffMembers)

</div>
