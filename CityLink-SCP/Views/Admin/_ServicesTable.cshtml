@using CityLink_SCP.DbModels
@model List<Service>
@{
    string sortBy    = ViewData["SortBy"]    as string ?? "Id";
    string sortOrder = ViewData["SortOrder"] as string ?? "desc";

    string SortClass(string field) =>
        sortBy == field ? "th-sort-" + sortOrder : "";
}

@if (Model != null && Model.Any())
{
    <div class="table-wrap">
        <table class="admin-table" id="servicesTable">
            <thead>
                <tr>
                    <th data-hide-priority="1"
                        data-sort="Id"          class="@SortClass("Id")">ID</th>
                    <th data-sort="Title"       class="@SortClass("Title")">Title</th>
                    <th data-hide-priority="5"
                        data-sort="Location"    class="@SortClass("Location")">Location</th>
                    <th data-hide-priority="3"
                        data-sort="Cost"        class="@SortClass("Cost")">Cost / hr</th>
                    <th data-hide-priority="4"
                        data-sort="Available_Start_Time" class="@SortClass("Available_Start_Time")">Available</th>
                    <th data-hide-priority="2"
                        data-sort="StaffName"   class="@SortClass("StaffName")">Staff</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var svc in Model)
                {
                    <tr data-service-id="@svc.Id">
                        <td class="col-muted">#@svc.Id</td>
                        <td>@svc.Title</td>
                        <td class="col-muted">@svc.Location</td>
                        <td>$@svc.Cost.ToString("0.00")</td>
                        <td class="col-muted">@svc.Available_Start_Time.ToString(@"hh\:mm") – @svc.Available_End_Time.ToString(@"hh\:mm")</td>
                        <td class="col-muted">@svc.Staff?.FirstName @svc.Staff?.LastName</td>
                        <td class="col-actions">
                            <button class="btn--admin btn--ghost btn--sm view-service-btn" data-id="@svc.Id">View</button>
                            <button class="btn--admin btn--ghost btn--sm edit-service-btn" data-id="@svc.Id">Edit</button>
                            <button class="btn--admin btn--danger btn--sm delete-service-btn" data-id="@svc.Id" data-title="@svc.Title">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" />
}
else
{
    <div class="empty-state">No services match your search.</div>
}
