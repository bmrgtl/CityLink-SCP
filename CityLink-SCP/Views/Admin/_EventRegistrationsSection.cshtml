@using CityLink_SCP.DbModels
@model List<EventRegistration>

<section class="admin-section">
    <div class="admin-section__head">
        <div>
            <h2 class="admin-section__title">Event Registrations</h2>
            <p class="admin-section__desc">All community event sign-ups.</p>
        </div>
    </div>

    <form class="table-search" id="regs-search-form">
        <input type="hidden" name="SortBy"    value="EventId" />
        <input type="hidden" name="SortOrder" value="desc" />
        <input type="hidden" name="Page"      value="1" />
        <input type="hidden" name="Size"      value="20" />
        <div class="table-search__row">
            <div class="table-search__field table-search__field--sm">
                <label class="crud-field__label" for="reg-minattn">Min Attendees</label>
                <input type="number" class="crud-input" id="reg-minattn" name="MinAttendees" min="1" placeholder="1" />
            </div>
            <div class="table-search__field table-search__field--sm">
                <label class="crud-field__label" for="reg-maxattn">Max Attendees</label>
                <input type="number" class="crud-input" id="reg-maxattn" name="MaxAttendees" min="1" placeholder="100" />
            </div>
            <div class="table-search__field table-search__field--sm">
                <label class="crud-field__label" for="reg-mincost">Min $</label>
                <input type="number" class="crud-input" id="reg-mincost" name="MinCost" min="0" step="0.01" placeholder="0.00" />
            </div>
            <div class="table-search__field table-search__field--sm">
                <label class="crud-field__label" for="reg-maxcost">Max $</label>
                <input type="number" class="crud-input" id="reg-maxcost" name="MaxCost" min="0" step="0.01" placeholder="0.00" />
            </div>
        </div>
        <div class="table-search__actions">
            <button type="submit" class="btn--admin btn--primary btn--sm" id="regSearchBtn">Search</button>
            <button type="button" class="btn--admin btn--ghost btn--sm" id="regClearBtn" style="display:none;">Clear</button>
        </div>
    </form>

    <div id="regs-table-container">
        <partial name="_EventRegistrationsTable" model="@Model" />
    </div>
</section>
