@using CityLink_SCP.DbModels
@model List<ApplicationUser>
@{
    string sortBy    = ViewData["SortBy"]    as string ?? "Id";
    string sortOrder = ViewData["SortOrder"] as string ?? "asc";

    string SortClass(string field) =>
        sortBy == field ? "th-sort-" + sortOrder : "";
}

@if (Model != null && Model.Any())
{
    <div class="table-wrap">
        <table class="admin-table" id="usersTable">
            <thead>
                <tr>
                    <th data-sort="Id"        class="@SortClass("Id")">ID</th>
                    <th data-sort="LastName"  class="@SortClass("LastName")">Name</th>
                    <th data-sort="Email"     class="@SortClass("Email")">Email</th>
                    <th data-sort="PhoneNumber" class="@SortClass("PhoneNumber")">Phone</th>
                    <th data-sort="Address"     class="@SortClass("Address")">Address</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr data-user-id="@u.Id">
                        <td class="col-muted">#@u.Id</td>
                        <td>@u.FirstName @u.LastName</td>
                        <td class="col-muted">@u.Email</td>
                        <td class="col-muted">@u.PhoneNumber</td>
                        <td class="col-muted">@(u.Address.Length > 40 ? u.Address[..40] + "…" : u.Address)</td>
                        <td class="col-actions">
                            <button class="btn--admin btn--ghost btn--sm view-user-btn" data-id="@u.Id">View</button>
                            <button class="btn--admin btn--ghost btn--sm edit-user-btn" data-id="@u.Id">Edit</button>
                            <button class="btn--admin btn--danger btn--sm delete-user-btn" data-id="@u.Id" data-name="@u.FirstName @u.LastName">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" />
}
else
{
    <div class="empty-state">No users match your search.</div>
}
