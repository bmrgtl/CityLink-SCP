@using CityLink_SCP.DbModels
@model List<ServiceBooking>

<section class="admin-section">
    <div class="admin-section__head">
        <div>
            <h2 class="admin-section__title">Service Bookings</h2>
            <p class="admin-section__desc">All community service bookings.</p>
        </div>
    </div>

    <form class="table-search" id="bookings-search-form">
        <input type="hidden" name="SortBy"    value="Start_Time" />
        <input type="hidden" name="SortOrder" value="desc" />
        <input type="hidden" name="Page"      value="1" />
        <input type="hidden" name="Size"      value="20" />
        <div class="table-search__row">
            <div class="table-search__field table-search__field--sm">
                <label class="crud-field__label" for="bk-mincost">Min $</label>
                <input type="number" class="crud-input" id="bk-mincost" name="MinCost" min="0" step="0.01" placeholder="0.00" />
            </div>
            <div class="table-search__field table-search__field--sm">
                <label class="crud-field__label" for="bk-maxcost">Max $</label>
                <input type="number" class="crud-input" id="bk-maxcost" name="MaxCost" min="0" step="0.01" placeholder="0.00" />
            </div>
            <div class="table-search__field">
                <label class="crud-field__label" for="bk-from">From</label>
                <input type="datetime-local" class="crud-input" id="bk-from" name="From" />
            </div>
            <div class="table-search__field">
                <label class="crud-field__label" for="bk-to">To</label>
                <input type="datetime-local" class="crud-input" id="bk-to" name="To" />
            </div>
        </div>
        <div class="table-search__actions">
            <button type="submit" class="btn--admin btn--primary btn--sm" id="bookingSearchBtn">Search</button>
            <button type="button" class="btn--admin btn--ghost btn--sm" id="bookingClearBtn" style="display:none;">Clear</button>
        </div>
    </form>

    <div id="bookings-table-container">
        <partial name="_ServiceBookingsTable" model="@Model" />
    </div>
</section>
