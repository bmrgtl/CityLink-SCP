@using CityLink_SCP.DbModels
@model List<ApplicationStaff>
@{
    string sortBy    = ViewData["SortBy"]    as string ?? "Id";
    string sortOrder = ViewData["SortOrder"] as string ?? "asc";

    string SortClass(string field) =>
        sortBy == field ? "th-sort-" + sortOrder : "";
}

@if (Model != null && Model.Any())
{
    <div class="table-wrap">
        <table class="admin-table" id="staffTable">
            <thead>
                <tr>
                    <th data-hide-priority="1" 
                        data-sort="Id"       class="@SortClass("Id")">ID</th>
                    <th data-sort="LastName" class="@SortClass("LastName")">Name</th>
                    <th data-hide-priority="2" 
                        data-sort="Email" class="@SortClass("Email")">Email</th>
                    <th data-hide-priority="3" 
                        data-sort="PhoneNumber" class="@SortClass("PhoneNumber")">Phone</th>
                    <th data-sort="JobTitle" class="@SortClass("JobTitle")">Role</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr data-staff-id="@s.Id">
                        <td class="col-muted">#@s.Id</td>
                        <td>@s.FirstName @s.LastName</td>
                        <td class="col-muted">@s.Email</td>
                        <td class="col-muted">@s.PhoneNumber</td>
                        <td><span class="tag">@s.JobTitle</span></td>
                        <td class="col-actions">
                            <button class="btn--admin btn--ghost btn--sm view-staff-btn" data-id="@s.Id">View</button>
                            <button class="btn--admin btn--ghost btn--sm edit-staff-btn" data-id="@s.Id">Edit</button>
                            <button class="btn--admin btn--danger btn--sm delete-staff-btn" data-id="@s.Id" data-name="@s.FirstName @s.LastName">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" />
}
else
{
    <div class="empty-state">No staff members match your search.</div>
}
