@using CityLink_SCP.DbModels
@model List<ApplicationStaff>

<section class="admin-section">
    <div class="admin-section__head">
        <div>
            <h2 class="admin-section__title">Staff Members</h2>
            <p class="admin-section__desc">Manage portal staff accounts and roles.</p>
        </div>
        <button class="btn--admin btn--primary" id="newStaffBtn">+ New Staff</button>
    </div>

    <form class="table-search" id="staff-search-form">
        <input type="hidden" name="SortBy"    value="LastName" />
        <input type="hidden" name="SortOrder" value="asc" />
        <input type="hidden" name="Page"      value="1" />
        <input type="hidden" name="Size"      value="20" />
        <div class="table-search__row">
            <div class="table-search__field table-search__field--lg">
                <label class="crud-field__label" for="stf-term">Search</label>
                <input type="text" class="crud-input" id="stf-term" name="SearchTerm" placeholder="Name or email…" />
            </div>
            <div class="table-search__field">
                <label class="crud-field__label" for="stf-role">Role</label>
                <input type="text" class="crud-input" id="stf-role" name="JobTitle" placeholder="Contains…" />
            </div>
        </div>
        <div class="table-search__actions">
            <button type="submit" class="btn--admin btn--primary btn--sm" id="staffSearchBtn">Search</button>
            <button type="button" class="btn--admin btn--ghost btn--sm" id="staffClearBtn" style="display:none;">Clear</button>
        </div>
    </form>

    <div id="staff-table-container">
        <partial name="_StaffTable" model="@Model" />
    </div>
</section>
