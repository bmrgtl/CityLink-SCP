@using CityLink_SCP.DbModels
@model List<Feedback>
@{
    string sortBy    = ViewData["SortBy"]    as string ?? "Id";
    string sortOrder = ViewData["SortOrder"] as string ?? "desc";

    string SortClass(string field) =>
        sortBy == field ? "th-sort-" + sortOrder : "";
}

@if (Model != null && Model.Any())
{
    <div class="table-wrap">
        <table class="admin-table" id="feedbackTable">
            <thead>
                <tr>
                    <th data-sort="Id"        class="@SortClass("Id")">ID</th>
                    <th data-sort="UserName" class="@SortClass("UserName")">From</th>
                    <th data-sort="Message" class="@SortClass("Message")">Message</th>
                    <th data-sort="Status"    class="@SortClass("Status")">Status</th>
                    <th data-sort="CreatedAt" class="@SortClass("CreatedAt")">Received</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fb in Model)
                {
                    <tr data-feedback-id="@fb.Id">
                        <td class="col-muted">#@fb.Id</td>
                        <td>@(fb.User != null ? $"{fb.User.FirstName} {fb.User.LastName}" : "(Guest)")</td>
                        <td class="col-muted">@(fb.Message.Length > 65 ? fb.Message[..65] + "…" : fb.Message)</td>
                        <td>
                            <span class="badge @(fb.Status == FeedbackStatus.Resolved || fb.Status == FeedbackStatus.Closed
                                ? "badge--active" : "badge--inactive")">
                                @fb.Status
                            </span>
                        </td>
                        <td class="col-muted">@fb.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td class="col-actions">
                            <button class="btn--admin btn--ghost btn--sm view-feedback-btn" data-id="@fb.Id">View</button>
                            <button class="btn--admin btn--ghost btn--sm edit-feedback-btn" data-id="@fb.Id">Resolve</button>
                            <button class="btn--admin btn--danger btn--sm delete-feedback-btn" data-id="@fb.Id">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" />
}
else
{
    <div class="empty-state">No feedback matches your search.</div>
}
