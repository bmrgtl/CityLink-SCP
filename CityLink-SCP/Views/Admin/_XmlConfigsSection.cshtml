@using CityLink_SCP.Models
@using CityLink_SCP.Services
@model List<XmlConfigDto>

<!--  XML Configurations  -->
<section class="admin-section">
    <div class="admin-section__head">
        <div>
            <h2 class="admin-section__title">XML Configurations</h2>
            <p class="admin-section__desc">Manage site-wide content layouts. The active version is applied live.</p>
        </div>
        <button class="btn--admin btn--primary" id="newConfigBtn">+ New Config</button>
    </div>

    <form class="table-search" id="xml-search-form">
        <input type="hidden" name="SortBy"    value="Id" />
        <input type="hidden" name="SortOrder" value="desc" />
        <input type="hidden" name="Page"      value="1" />
        <input type="hidden" name="Size"      value="20" />
        <div class="table-search__row">
            <div class="table-search__field table-search__field--lg">
                <label class="crud-field__label" for="xml-label">Label</label>
                <input type="text" class="crud-input" id="xml-label" name="Label" placeholder="Contains…" />
            </div>
            <div class="table-search__field">
                <label class="crud-field__label" for="xml-active">Status</label>
                <select class="crud-input" id="xml-active" name="IsActive">
                    <option value="">All</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
        </div>
        <div class="table-search__actions">
            <button type="submit" class="btn--admin btn--primary btn--sm" id="xmlSearchBtn">Search</button>
            <button type="button" class="btn--admin btn--ghost btn--sm" id="xmlClearBtn" style="display:none;">Clear</button>
        </div>
    </form>

    <div id="xml-configs-table-container">
        <partial name="_XmlConfigsTable" model="@Model" />
    </div>
</section>
