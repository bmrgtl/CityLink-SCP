<form method="post">
    <div class="input-box">
        <input class="input-field" name="username" placeholder="Username" required />
    </div>
    <div class="input-box">
        <input class="input-field" name="password" placeholder="Password" required type="password" />
    </div>
    <div class="input-submit">
        <button class="submit-btn" id="submit" type="submit">Log In</button>
    </div>
    <div class="error-msg">
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
    </div>
</form>