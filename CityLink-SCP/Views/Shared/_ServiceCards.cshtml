@model ServicesViewModel

<div class="carousel__track" id="servicesTrack">
@foreach(var card in Model.Services)
{
    <article class="card">
        <div class="placeholder placeholder--card"></div>
        <div class="card__body">
            <h3 class="card__title">@card.Title</h3>
            <p class="card__text">@card.Description</p>
            <a asp-area="" asp-controller="Home" asp-action="BookEvent" class="btn btn--outline">@card.ButtonLabel</a>
        </div>
    </article>
}
<</div>
<div class="carousel__controls">
    <button class="carousel__btn" id="servicesPrev">&#8592;</button>
    <div class="carousel__dots" id="servicesDots"></div>
    <button class="carousel__btn" id="servicesNext">&#8594;</button>
</div>