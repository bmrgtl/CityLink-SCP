<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CityLink Initiatives</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    @RenderSection("Styles", required: false)

</head>

<body>

    <nav class="nav">
        <div class="nav__inner">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="nav__logo">CityLink.</a>

            <ul class="nav_links">
                <li><a asp-area="" asp-controller="Home" asp-action="WhatsOn" class="nav_link">What's On</a></li>
                <li><a asp-area="" asp-controller="Home" asp-action="Events" class="nav_link">Events</a></li>
                <li><a asp-area="" asp-controller="Home" asp-action="Services" class="nav_link">Our Services</a></li>
                <li><a asp-area="" asp-controller="Home" asp-action="ContactUs" class="nav_link">Contact Us</a></li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li><a asp-area="" asp-controller="Home" asp-action="Profile" class="nav_link">Profile</a></li>
                    <li>
                        @if (User.IsInRole("Staff"))
                        {
                            <form asp-controller="AdminAuth" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="nav_cta">Sign Out</button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Home" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="nav_cta">Sign Out</button>
                            </form>
                        }
                    </li>
                }
                else
                {
                    <li><a asp-area="" asp-controller="Home" asp-action="Login" class="nav_cta">Log In</a></li>
                }
            </ul>

            <button class="nav__hamburger" id="menuBtn" aria-label="Toggle menu" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>
        </div>

        <div class="nav__mobile" id="mobileMenu">
            <a asp-area="" asp-controller="Home" asp-action="WhatsOn" class="nav__mobile-link">What's On</a>
            <a asp-area="" asp-controller="Home" asp-action="Events" class="nav__mobile-link">Events</a>
            <a asp-area="" asp-controller="Home" asp-action="Services" class="nav__mobile-link">Services</a>
            <a asp-area="" asp-controller="Home" asp-action="ContactUs" class="nav__mobile-link">Contact Us</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-area="" asp-controller="Home" asp-action="Profile" class="nav__mobile-link">Profile</a>
                @if (User.IsInRole("Staff"))
                {
                    <form asp-controller="AdminAuth" asp-action="Logout" method="post" style="margin:0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="nav__mobile-link nav__mobile-link--bold" style="background:none;border:none;cursor:pointer;font-family:inherit;width:100%;text-align:left;padding:0;">Sign Out</button>
                    </form>
                }
                else
                {
                    <form asp-controller="Home" asp-action="Logout" method="post" style="margin:0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="nav__mobile-link nav__mobile-link--bold" style="background:none;border:none;cursor:pointer;font-family:inherit;width:100%;text-align:left;padding:0;">Sign Out</button>
                    </form>
                }
            }
            else
            {
                <a asp-area="" asp-controller="Home" asp-action="Login" class="nav__mobile-link nav__mobile-link--bold">Log In</a>
            }
        </div>
    </nav>
    <!-- BODY -->
    <main>
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="container footer__grid">
            <div>
                <p class="footer__logo">CityLink<br />Initiatives</p>
                <p class="footer__small">Copyright &copy; 2026<br />Government of Western Australia.<br />All rights reserved.</p>
                <p class="footer__small">info@citylink.wa.gov.au<br />Fictional Address, Perth WA 6000</p>
            </div>
            <div>
                <p class="footer__heading">Need Help?</p>
                <ul class="footer__links">
                    <li><a href="#">Contact Us</a></li>
                    <li><a href="#">(08) 9999 9999</a></li>
                    <li><a href="#">info@citylink.wa.gov.au</a></li>
                </ul>
            </div>
            <div>
                <p class="footer__heading">Quick Links</p>
                <ul class="footer__links">
                    <li><a href="#">Announcements</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Services">Our Services</a></li>
                    <li><a href="#">FAQs</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="ContactUs">Feedback Form</a></li>
                    <li><a asp-area="" asp-controller="Admin" asp-action="Index">Staff Portal</a></li>
                </ul>
            </div>
            <div>
                <p class="footer__heading">Social Media</p>
                <ul class="footer__links">
                    <li><a href="#">Facebook</a></li>
                    <li><a href="#">Instagram</a></li>
                    <li><a href="#">LinkedIn</a></li>
                </ul>
            </div>
        </div>
        <div class="footer__ack">
            <div class="container">
                <p class="footer__ack-title">Acknowledgement of Country</p>
                <p class="footer__ack-text">The Government of Western Australia acknowledges the traditional owners throughout Western Australia and their continuing connection to the land, waters and community. We pay our respects to all members of the Aboriginal communities and their cultures; and to Elders both past and present.</p>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>