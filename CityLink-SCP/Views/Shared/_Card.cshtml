@model List<CardViewModel>

@foreach(var card in Model)
{
    <article class="card">
        <div class="placeholder placeholder--card"></div>
        <div class="card__body">
            <h3 class="card__title">@card.Title</h3>
            <p class="card__text">@card.Description</p>
            <a href="services.html" class="btn btn--outline">@card.ButtonLabel</a>
        </div>
    </article>
}