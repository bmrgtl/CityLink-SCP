@using CityLink_SCP.DbModels
@model CityLink_SCP.ViewModels.BookService

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
    <link rel="stylesheet" href="~/css/bookservice.css" />
}

<section id="service">
    <div class="container">
        <h2 class="news__heading">@Model.PageHeading</h2>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <hr />

        <div class="bookings-container">
            <h3 class="booking-heading">@Model.FormHeading</h3>
            <div class="bookings">
                <form method="post"
                      asp-controller="Home" asp-action="BookService"
                      class="book-form-col">
                    @Html.AntiForgeryToken()

                    <div class="form-left">

                        @{
                            var selectedId = ViewData["SelectedServiceId"] as int?;
                        }
                        <div class="input-box">
                            <select class="input-field" name="serviceId" required id="serviceSelect">
                                <option value="">— Choose a Service —</option>
                                @foreach (var svc in Model.AvailableServices)
                                {
                                    var svcStart = svc.Available_Start_Time.ToString("HH:mm");
                                    var svcEnd   = svc.Available_End_Time.ToString("HH:mm");
                                    var svcCost  = svc.Cost.ToString("0.00");
                                    var isSel    = selectedId.HasValue && selectedId.Value == svc.Id;
                                    <option value="@svc.Id"
                                            data-start="@svcStart"
                                            data-end="@svcEnd"
                                            data-cost="@svcCost"
                                            selected="@isSel">
                                        @svc.Title — $@svcCost/hr
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="datetime-row">
                            <div class="input-box">
                                <label class="ann__text">Start Date &amp; Time</label>
                                <input name="startTime" type="datetime-local" class="input-field" required
                                       id="bookStartTime" />
                            </div>
                            <div class="input-box">
                                <label class="ann__text">End Date &amp; Time</label>
                                <input name="endTime" type="datetime-local" class="input-field" required
                                       id="bookEndTime" />
                            </div>
                        </div>

                        <div class="input-box">
                            <p class="ann__text" id="availHint" style="color:var(--muted,#666);font-size:0.9rem;"></p>
                        </div>

                        @if (Model.User == null)
                        {
                            <p class="ann__text" style="color:var(--red,#c00);">
                                Please <a asp-action="Signin">sign in</a> to book a service.
                            </p>
                        }

                        <div class="error-msg">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                        </div>
                    </div>

                    <div class="summary-col">
                        <div class="service-details">
                            <p id="summaryTitle">Select a service above</p>
                            <hr />
                            <div class="booking-details">
                                <p>Cost/hr</p>
                                <p id="summaryCost">—</p>
                            </div>
                            <hr />
                            <div class="booking-details">
                                <p>Available</p>
                                <p id="summaryAvail">—</p>
                            </div>
                        </div>

                        <div class="input-submit">
                            @if (Model.User != null)
                            {
                                <button class="submit-btn" type="submit">Book Service</button>
                            }
                            else
                            {
                                <a asp-action="Signin" class="submit-btn" style="display:inline-block;text-align:center;">Sign In to Book</a>
                            }
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        var sel = document.getElementById('serviceSelect');
        function updateSummary() {
            var opt = sel.options[sel.selectedIndex];
            if (!opt || !opt.value) {
                document.getElementById('summaryTitle').textContent = 'Select a service above';
                document.getElementById('summaryCost').textContent = '—';
                document.getElementById('summaryAvail').textContent = '—';
                document.getElementById('availHint').textContent = '';
                return;
            }
            document.getElementById('summaryTitle').textContent = opt.text.split('—')[0].trim();
            document.getElementById('summaryCost').textContent = '$' + opt.dataset.cost + '/hr';
            var avail = opt.dataset.start + ' – ' + opt.dataset.end;
            document.getElementById('summaryAvail').textContent = avail;
            document.getElementById('availHint').textContent = 'Available: ' + avail;
        }
        sel.addEventListener('change', updateSummary);
        updateSummary();
    })();
</script>
