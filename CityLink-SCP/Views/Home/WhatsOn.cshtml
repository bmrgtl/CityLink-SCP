@using CityLink_SCP.PageModels
@model IndexViewModel
@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
    <link rel="stylesheet" href="~/css/whatson.css" />
}

@section Scripts {
    <script src="~/js/index.js"></script>
}
<section id="news" class="section section--cream">
    <div class="container">
        <partial name="_Announcements" model="@Model.Announcements" />
    </div>
</section>

<section id="events" class="section">
    <div class="container">
        <h2 class="news__heading">Other News</h2>

        <div class="searchsort">
            <form method="get" asp-controller="Home" asp-action="WhatsOn">
                <div class="input-box">
                    <input class="input-field" name="search" placeholder="Search events…"
                           value="@ViewData["Search"]" />
                </div>
                <div class="sort-select">
                    @{
                        var currentSort = ViewData["Sort"]?.ToString();
                    }
                    <select class="input-field" name="sort">
                        <option value="" selected="@(currentSort == null)">Sort By</option>
                        <option value="alphabetical" selected="@(currentSort == "alphabetical")">A – Z</option>
                        <option value="date" selected="@(currentSort == "date")">Date</option>
                    </select>
                </div>
                <div class="input-submit">
                    <button class="submit-btn" type="submit">Apply</button>
                </div>
                @if (!string.IsNullOrEmpty(ViewData["Search"]?.ToString()))
                {
                    <div class="input-submit" style="margin-left:0.5rem;">
                        <a asp-action="WhatsOn" class="submit-btn" style="background:var(--muted,#666);">Clear</a>
                    </div>
                }
            </form>
        </div>
     
            <partial name="@Model.Events.PartialName" model="@Model.Events" />
    </div>
</section>


