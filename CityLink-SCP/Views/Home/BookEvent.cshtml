@model CityLink_SCP.ViewModels.BookEvent

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
    <link rel="stylesheet" href="~/css/bookservice.css" />
}

<section id="service">
    <div class="container">
        <h2 class="news__heading">@Model.Event.Title</h2>
        <p class="ann__text">@Model.Event.Location | @Model.Event.Start_Date_Time.ToString("R")</p>
        <p class="ann__text">
            @Model.Event.Description
        </p>
        <hr />

        <div class="bookings-container">
            <h3 class="booking-heading">Book Event</h3>
            <div class="bookings">
                <form method="post" class="book-form-col" >
                    <div class="form-left">
                        <div class="datetime-row">
                            <div class="input-box">
                                <input asp-for="User.First_Name" class="input-field" placeholder="First Name" required/>
                            </div>
                            <div class="input-box">
                                <input asp-for="User.Last_Name" class="input-field" placeholder="Last Name" required />
                            </div>
                        </div>

                        <div class="input-box">
                            <input asp-for="User.Phone_Number" class="input-field" placeholder="Mobile Number" />
                        </div>

                        <div class="datetime-row">
                            <div class="input-box">
                                <p class="ann__text">Number of Tickets </p>
                            </div>
                            <div class="input-box">
                                <input asp-for="EventRegistration.NumberOfAttendees" class="input-field" style="width: 30%; text-align:center; " type="number" value="1" min="1" max="5" step="1" />
                            </div>

                        </div>

                        <div class="error-msg">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                        </div>
                    </div>

                    <div class="summary-col">
                        <div class="service-details">
                            <p>@Model.Event.Title</p>
                            <p>@Model.Event.Start_Date_Time.ToString("f")</p>
                            <hr />
                            <div class="booking-details">
                                <p>1x Ticket</p>
                                <p>$0.00</p>
                            </div>
                            <hr />
                            <div class="booking-details">
                                <p>Subtotal</p>
                                <p>$0.00</p>
                            </div>
                            <hr />
                            <div class="booking-details">
                                <h3>Total</h3>
                                <p>$0.00</p>
                            </div>
                        </div>

                        <div class="input-submit">
                            <button class="submit-btn" id="submit" type="submit">Book Event</button>
                        </div>
                    </div>

                </form>

            </div>
        </div>
    </div>

</section>
