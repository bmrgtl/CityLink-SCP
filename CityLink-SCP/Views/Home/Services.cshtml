@using CityLink_SCP.DbModels
@model List<Service>

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
    <link rel="stylesheet" href="~/css/services.css" />
}

@section Scripts {
    <script src="~/js/public-search.js"></script>
    <script>
        $(function () {
            wirePublicSearch(
                "services-search-form", "services-cards-container", "SearchPublicServices",
                "svcClearBtn", "svc-sortby-select", "svc-sortdir", "svc-sortby-hidden", "svc-sortorder-hidden"
            );
        });
    </script>
}

<section class="section-white">
    <div class="container">
        <h2 class="news__heading">Our Services.</h2>
        <div class="rates-container">
            <h3 class="heading-md">Our Rates</h3>
            <div class="rates-info">
                <table class="rates-table">
                    <thead>
                        <tr>
                            <th scope="col">Service</th>
                            <th scope="col">Fees</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>Green Waste Collection</td><td>$45.00</td></tr>
                        <tr><td>Service 2</td><td>$5.00</td></tr>
                        <tr><td>Service 3</td><td>$45.00</td></tr>
                        <tr><td>Service 4</td><td>$145.00</td></tr>
                    </tbody>
                </table>

                <div class="rates-questions">
                    <p class="ann__eyebrow">Can't Find What You're Looking For?</p>
                    <p class="ann__text">Enquire Now</p>
                    <form>
                        <div class="contact-info">
                            <div class="input-box">
                                <input class="input-field" name="name" placeholder="Name" required />
                            </div>
                            <div class="input-box">
                                <input class="input-field" name="email" placeholder="Email" type="email" required />
                            </div>
                        </div>
                        <div class="input-box">
                            <textarea rows="5" class="input-field" name="message" placeholder="Message" required></textarea>
                        </div>
                        <div class="input-submit">
                            <button type="submit" class="submit-btn">Submit Enquiry</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-white">
    <div class="container">
        <p class="ann__eyebrow">What We Offer</p>
        <h3 class="heading-md">Available Services</h3>

        <form class="pub-search" id="services-search-form">
            <input type="hidden" name="Page"      value="1" />
            <input type="hidden" name="Size"      value="12" />
            <input type="hidden" name="SortBy"    id="svc-sortby-hidden"    value="Title" />
            <input type="hidden" name="SortOrder" id="svc-sortorder-hidden" value="asc" />
            <div class="pub-search__row">
                <div class="pub-search__field pub-search__field--lg">
                    <label class="pub-search__label" for="svc-term">Search</label>
                    <input class="pub-search__input" id="svc-term" name="SearchTerm" placeholder="Title, description or location…" />
                </div>
                <div class="pub-search__field">
                    <label class="pub-search__label" for="svc-from">Available From</label>
                    <input type="time" class="pub-search__input" id="svc-from" name="From" />
                </div>
                <div class="pub-search__field">
                    <label class="pub-search__label" for="svc-to">Available Until</label>
                    <input type="time" class="pub-search__input" id="svc-to" name="To" />
                </div>
                <div class="pub-search__field" style="max-width:fit-content;">
                    <label class="pub-search__label" for="svc-sortby-select">Sort By</label>
                    <div style="display:flex;gap:0.4rem;">
                        <select class="pub-search__input pub-search__sort-select" id="svc-sortby-select" style="flex:1;">
                            <option value="Title">Title (A–Z)</option>
                            <option value="Location">Location</option>
                            <option value="Cost">Cost</option>
                            <option value="Available_Start_Time">Available From</option>
                        </select>
                        <button type="button" class="btn--sort-dir" id="svc-sortdir" title="Toggle sort direction">&#9650;</button>
                    </div>
                </div>
            </div>
            <div class="pub-search__actions">
                <button type="submit" class="btn btn--outline">Search</button>
                <button type="button" class="btn--ghost" id="svcClearBtn" style="display:none">Clear</button>
            </div>
        </form>

        <div id="services-cards-container">
            <partial name="_ServiceCardGrid" model="@Model" />
        </div>
    </div>
</section>

<section class="section section--cream">
    <div class="container">
        <h3 class="heading-md">Waste Collection Schedule</h3>
        <div class="schedule-info">
            <table class="schedule-table">
                <thead>
                    <tr><th scope="col">Bin</th><th scope="col">Day</th></tr>
                </thead>
                <tbody>
                    <tr><td>Yellow Bin (Recycling)</td><td>Monday</td></tr>
                    <tr><td>Red Lid Bin (Green Waste)</td><td>Tuesday</td></tr>
                    <tr><td>Other</td><td>Wednesday</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</section>
