@model CityLink_SCP.ViewModels.ContactUs
@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
    <link rel="stylesheet" href="~/css/bookservice.css" />
}

<section>
    <div class="container" style="margin-top: 1.25rem; margin-bottom: 2rem;">
        <h2 class="news__heading">@Model.PageHeading</h2>
        <p class="ann__text">@Model.PageSubHeading</p>

        <div class="feedback-form">
            <p class="ann__text" style="font-size:1.2rem;">@Model.FormTitle</p>
            <form>
                <div class="datetime-row">
                    <div class="input-box">
                        <input class="input-field" name="name" placeholder="@Model.NamePlaceHolder"/>
                    </div>
                    <div class="input-box">
                        <input class="input-field" name="contact" placeholder="@Model.ContactPlaceHolder"/>
                    </div>
                </div>

                <div class="input-box">
                    <textarea rows="10" class="input-field" name="message" placeholder="@Model.InputAreaPlaceHolder" required></textarea>
                </div>
                <div class="input-submit">
                    <button type="submit" class="submit-btn">@Model.ButtonLabel</button>
                </div>
            </form>
        </div>
    </div>
</section>