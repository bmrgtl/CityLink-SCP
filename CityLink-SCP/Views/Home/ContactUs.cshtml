@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
    <link rel="stylesheet" href="~/css/bookservice.css" />
}

<section>
    <div class="container" style="margin-top: 1.25rem; margin-bottom: 2rem;">
        <h2 class="news__heading">Contact Us</h2>
        <p class="ann__text">PHONE: (08) XXX XXX | EMAIL: INFO@CITYLINK.WA.GOV.AU</p>

        <div class="feedback-form">
            <p class="ann__text" style="font-size:1.2rem;">Let us know your thoughts!</p>
            <form>
                <div class="datetime-row">
                    <div class="input-box">
                        <input class="input-field" name="name" placeholder="Name"/>
                    </div>
                    <div class="input-box">
                        <input class="input-field" name="contact" placeholder="contact"/>
                    </div>
                </div>

                <div class="input-box">
                    <textarea rows="10" class="input-field" name="message" placeholder="Message" required></textarea>
                </div>
                <div class="input-submit">
                    <button type="submit" class="submit-btn">Submit Enquiry</button>
                </div>
            </form>
        </div>
    </div>
</section>