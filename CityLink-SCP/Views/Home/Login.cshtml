@model CityLink_SCP.PageModels.AdminLoginViewModel

@{
    var title = ViewData["LoginTitle"]?.ToString() ?? "Log Into CityLink";
    var isStaffPortal = title == "Staff Portal";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" />
}

<div class="account-container">
    <h1>@title.</h1>
    @if (isStaffPortal)
    {
        <div class="sign-up-link">
            <p><a asp-area="" asp-controller="Home" asp-action="Index">← Back to CityLink</a></p>
        </div>
    }
    else
    {
        <div class="sign-up-link">
            <p>New to CityLink? <a class="sign-up-link" asp-area="" asp-controller="Home" asp-action="Signin">Sign Up Here</a>.</p>
        </div>
    }

    <partial name="_LoginForm" model="@Model" />
</div>
