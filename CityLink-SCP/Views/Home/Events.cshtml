@using CityLink_SCP.DbModels
@model List<Event>

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
    <link rel="stylesheet" href="~/css/whatson.css" />
}

@section Scripts {
    <script src="~/js/public-search.js"></script>
    <script>
        $(function () {
            wirePublicSearch(
                "events-search-form", "events-cards-container", "SearchPublicEvents",
                "evClearBtn", "ev-sortby-select", "ev-sortdir", "ev-sortby-hidden", "ev-sortorder-hidden"
            );
        });
    </script>
}

<section class="section">
    <div class="container">
        <p class="eyebrow">Community Events</p>
        <h2 class="heading-lg">What's Happening</h2>

        <form class="pub-search" id="events-search-form">
            <input type="hidden" name="Page"      value="1" />
            <input type="hidden" name="Size"      value="12" />
            <input type="hidden" name="SortBy"    id="ev-sortby-hidden"    value="Start_Date_Time" />
            <input type="hidden" name="SortOrder" id="ev-sortorder-hidden" value="asc" />
            <div class="pub-search__row">
                <div class="pub-search__field pub-search__field--lg">
                    <label class="pub-search__label" for="ev-term">Search</label>
                    <input class="pub-search__input" id="ev-term" name="SearchTerm" placeholder="Title or description…" />
                </div>
                <div class="pub-search__field pub-search__field--lg">
                    <label class="pub-search__label" for="ev-location">Location</label>
                    <input class="pub-search__input" id="ev-location" name="Location" placeholder="e.g. City Square" />
                </div>
                <div class="pub-search__field pub-search__field--sm">
                    <label class="pub-search__label" for="ev-mincost">Min $</label>
                    <input type="number" class="pub-search__input" id="ev-mincost" name="MinCost" min="0" step="0.01" placeholder="0.00" />
                </div>
                <div class="pub-search__field pub-search__field--sm">
                    <label class="pub-search__label" for="ev-maxcost">Max $</label>
                    <input type="number" class="pub-search__input" id="ev-maxcost" name="MaxCost" min="0" step="0.01" placeholder="0.00" />
                </div>
                <div class="pub-search__field pub-search__field--date">
                    <label class="pub-search__label" for="ev-from">From</label>
                    <input type="datetime-local" class="pub-search__input" id="ev-from" name="From" />
                </div>
                <div class="pub-search__field pub-search__field--date">
                    <label class="pub-search__label" for="ev-to">To</label>
                    <input type="datetime-local" class="pub-search__input" id="ev-to" name="To" />
                </div>
                <div class="pub-search__field pub-search__field--sm">
                    <label class="pub-search__label" for="ev-avail">Tickets</label>
                    <select class="pub-search__input" id="ev-avail" name="TicketsAvaliable">
                        <option value="">Any</option>
                        <option value="true">Available</option>
                    </select>
                </div>
                <div class="pub-search__field" style="max-width:fit-content;">
                    <label class="pub-search__label" for="ev-sortby-select">Sort By</label>
                    <div style="display:flex;gap:0.4rem;">
                        <select class="pub-search__input pub-search__sort-select" id="ev-sortby-select" style="flex:1;">
                            <option value="Start_Date_Time">Date</option>
                            <option value="Title">Title (A–Z)</option>
                            <option value="Location">Location</option>
                            <option value="Cost">Cost</option>
                            <option value="Max_Capcity">Capacity</option>
                        </select>
                        <button type="button" class="btn--sort-dir" id="ev-sortdir" title="Toggle sort direction">&#9650;</button>
                    </div>
                </div>
            </div>
            <div class="pub-search__actions">
                <button type="submit" class="btn btn--outline">Search</button>
                <button type="button" class="btn--ghost" id="evClearBtn" style="display:none">Clear</button>
            </div>
        </form>

        <div id="events-cards-container">
            <partial name="_EventCardGrid" model="@Model" />
        </div>
    </div>
</section>
