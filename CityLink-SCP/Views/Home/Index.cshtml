@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->
<section class="hero text-center text-white d-flex align-items-center justify-content-center">
    <div>
        <h1 class="display-4 fw-bold">Welcome to the Smart Community Portal</h1>
        <p class="lead">All community services, events, and announcements in one place</p>
        <a href="/Services" class="btn btn-warning btn-lg mt-3">Explore Services</a>
    </div>
</section>

<!-- ANNOUNCEMENTS -->
<section class="container mt-5">
    <h2 class="text-center fw-bold mb-4">Latest Announcements</h2>
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card announcement-card text-center p-3">
                <h5>Community Cleanup</h5>
                <p>May 15, 2026</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card announcement-card text-center p-3">
                <h5>Library Closed</h5>
                <p>June 3, 2026</p>
            </div>
        </div>
    </div>
</section>

<!-- SERVICES CARDS -->
<section class="container mt-5">
    <h2 class="text-center fw-bold mb-4">Community Services</h2>
    <div class="row text-center g-4">
        <div class="col-md-3">
            <div class="card service-card p-3">
                <h5>Waste Collection</h5>
                <p>Check pickup schedules</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card service-card p-3">
                <h5>Rates Enquiry</h5>
                <p>View local rates</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card service-card p-3">
                <h5>Community Programs</h5>
                <p>Explore programs</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card service-card p-3">
                <h5>Book a Service</h5>
                <p>Make bookings online</p>
            </div>
        </div>
    </div>
</section>

<!-- EVENTS CAROUSEL -->
<section class="container mt-5">
    <h2 class="text-center fw-bold mb-4">Upcoming Events</h2>
    <div id="eventsCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">

            <div class="carousel-item active">
                <div class="card text-center p-4">
                    <h5>Community BBQ</h5>
                    <p>May 20, 2026</p>
                </div>
            </div>

            <div class="carousel-item">
                <div class="card text-center p-4">
                    <h5>Farmers Market</h5>
                    <p>June 2, 2026</p>
                </div>
            </div>

        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#eventsCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#eventsCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
</section>

<!-- FAQ -->
<section class="container mt-5 mb-5">
    <h2 class="text-center fw-bold mb-4">Frequently Asked Questions</h2>
    <div class="accordion" id="faqAccordion">
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                    How do I book a community service?
                </button>
            </h2>
            <div id="faq1" class="accordion-collapse collapse show">
                <div class="accordion-body">
                    Visit the Bookings page and fill out the form with your details.
                </div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                    How do I find local events?
                </button>
            </h2>
            <div id="faq2" class="accordion-collapse collapse">
                <div class="accordion-body">
                    Go to the Events page to view all upcoming community events.
                </div>
            </div>
        </div>
    </div>
</section>