@{
    ViewData["Title"] = "Home";
}

@model CityLink_SCP.Models.IndexViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
}

@section Scripts {
    <script src="~/js/index.js"></script>
}


<!-- HERO -->
<section class="hero">
    <div class="container hero__grid">
        <div>
            <h1 class="hero__title">CityLink<br />Initiatives</h1>
            <p class="hero__sub">Streamlining access to services and information online.</p>
            <a href="services.html" class="btn">View Services</a>
        </div>
        <div class="placeholder placeholder--hero"></div>
    </div>
</section>


<!-- SERVICES CAROUSEL -->
<section id="services" class="section">
    <div class="container">
        <p class="eyebrow">What We Offer</p>
        <h2 class="heading-lg">Our Services</h2>

        <partial name="_ServiceCards" model="@Model.Services" />   

        <div class="carousel__controls">
            <button class="carousel__btn" id="servicesPrev">&#8592;</button>
            <div class="carousel__dots" id="servicesDots"></div>
            <button class="carousel__btn" id="servicesNext">&#8594;</button>
        </div>
    </div>
</section>


<!-- NEWS -->
<section id="news" class="section section--cream">
    <div class="container">
        <p class="eyebrow">Announcements</p>
        <h2 class="heading-lg">What's On</h2>

        <!-- Announcement 1: image left, text right -->
        <div class="ann">
            <div class="placeholder placeholder--ann"></div>
            <div>
                <h3 class="ann__title">Announcement 1</h3>
                <p class="ann__text">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
                <a asp-area="" asp-controller="Home" asp-action="News" class="btn">Read More</a>
            </div>
        </div>

        <!-- Announcement 2: text left, image right (reversed) -->
        <div class="ann ann--reverse">
            <div class="placeholder placeholder--ann ann__image"></div>
            <div class="ann__copy">
                <h3 class="ann__title">Announcement 2</h3>
                <p class="ann__text">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
                <a asp-area="" asp-controller="Home" asp-action="News" class="btn">Read More</a>
            </div>
        </div>
    </div>
</section>


<!-- EVENTS CAROUSEL -->
<section id="events" class="section">
    <div class="container">
        <p class="eyebrow">Events On Right Now</p>
        <h2 class="heading-lg">What's Happening</h2>

        <partial name="_EventCards" model="@Model.Events" />
        
        <div class="carousel__controls">
            <button class="carousel__btn" id="eventsPrev">&#8592;</button>
            <div class="carousel__dots" id="eventsDots"></div>
            <button class="carousel__btn" id="eventsNext">&#8594;</button>
        </div>
    </div>
</section>


<!-- FAQ + CONTACT -->
<section class="section section--cream">
    <div class="container">
        <p class="eyebrow">Commonly Asked</p>
        <h2 class="heading-lg">Frequently Asked Questions</h2>

        <div class="faq__grid">

            <!-- FAQ accordion -->
            <partial name="_FAQ" model="@Model.FAQs" />

            <!-- Contact card -->
            <div id="contact" class="contact">
                <p class="contact__title">More Questions?</p>
                <p class="contact__sub">You can contact us at anytime.</p>
                <div class="contact__row">
                    <input type="email" placeholder="Email" />
                    <input type="tel" placeholder="Phone" />
                </div>
                <input type="text" placeholder="Subject" />
                <textarea placeholder="Message" rows="5"></textarea>
                <button class="btn--submit" type="button">Submit</button>
            </div>

        </div>
    </div>
</section>