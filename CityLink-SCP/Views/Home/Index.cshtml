@using CityLink_SCP.PageModels
@{
    ViewData["Title"] = "Home";
}

@model IndexViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
}

@section Scripts {
    <script src="~/js/index.js"></script>
}


<!-- HERO -->
<section class="hero">
    <div class="container hero__grid">
        <div>
            <h1 class="hero__title">CityLink<br />Initiatives</h1>
            <p class="hero__sub">Streamlining access to services and information online.</p>
            <a asp-controller="Home" asp-action="Services" class="btn">View Services</a>
        </div>
        <div class="placeholder placeholder--hero"></div>
    </div>
</section>


<!-- SERVICES CAROUSEL -->
<section id="services" class="section">
    <div class="container">
        <p class="eyebrow">What We Offer</p>
        <h2 class="heading-lg">Our Services</h2>

        <partial name="@Model.Services.PartialName" model="@Model.Services" />

    </div>
</section>


<!-- ANNOUNCEMENTS -->
<section id="news" class="section section--cream">
    <div class="container">
        <partial name="_Announcements" model="@Model.Announcements" />
    </div>
</section>


<!-- EVENTS CAROUSEL -->
<section id="events" class="section">
    <div class="container">
        <p class="eyebrow">Events On Right Now</p>
        <h2 class="heading-lg">What's Happening</h2>

        <partial name="@Model.Events.PartialName" model="@Model.Events" />
        
    </div>
</section>


<!-- FAQ + CONTACT -->
<section id="FAQs" class="section section--cream">
    <div class="container">
        <p class="eyebrow">Commonly Asked</p>
        <h2 class="heading-lg">Frequently Asked Questions</h2>

        <div class="faq__grid">

            <!-- FAQ accordion -->
            <partial name="@Model.FAQs.PartialName" model="@Model.FAQs" />

            <!-- Contact card -->
            <partial name="_EnquiryCard" model="@Model.Enquiry"/>

        </div>
    </div>
</section>